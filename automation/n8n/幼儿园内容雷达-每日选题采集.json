      "id": "c1",
      "name": "合并资讯",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [
        760,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const seen = new Set();\nconst rows = [];\nfor (const item of $input.all()) {\n  const j = item.json || {};\n  const link = j.link || j.url || '';\n  const title = (j.title || '').trim();\n  if (!title || !link || seen.has(link)) continue;\n  seen.add(link);\n  const hay = `${title} ${j.contentSnippet || j.content || ''}`;\n  let category = '综合学前教育';\n  if (/安全|消防|卫生|健康|防护/.test(hay)) category = '安全与健康';\n  else if (/家园|亲子|家长|家庭/.test(hay)) category = '家园共育';\n  else if (/课程|自然|游戏|活动|环境/.test(hay)) category = '课程与活动';\n  else if (/政策|通知|教育部|评估|管理/.test(hay)) category = '政策与管理';\n  const score = (/官方|教育部|教育厅|教育局/.test(hay) ? 2 : 0) + (/幼儿园|学前教育/.test(hay) ? 2 : 0) + (/安全|家园|课程|保教|政策/.test(hay) ? 1 : 0);\n  rows.push({ json: { title, link, pubDate: j.pubDate || j.isoDate || '', source: j.creator || j.author || 'RSS来源', category, priorityScore: score, summary: (j.contentSnippet || j.content || '').replace(/<[^>]*>/g, '').slice(0, 500), reviewStatus: '待人工核验', originalityReminder: '仅作选题参考；核验原文后重新构思，不复制原文或素材。' } });\n}\nrows.sort((a,b) => b.json.priorityScore - a.json.priorityScore);\nreturn rows.slice(0, 30);"
      },
